# Escenario A: backend en esta VM (EC2), frontend servido aparte en Cloudflare Pages.
# Expone /api, la documentacion (Swagger, con Basic Auth) y /healthz; la raiz redirige a
# Swagger y cualquier otra ruta responde 404 (el sitio estatico vive en Pages).

# nginx corre sin root (nginx-unprivileged): escucha en 8080/8443 dentro del contenedor;
# el compose los publica como 80/443 (HTTP_PORT/HTTPS_PORT).

# Conexiones persistentes hacia el backend. Sin esto nginx abre una conexion TCP nueva por
# peticion y, a ~300-400 req/s, agota los puertos efimeros (connect() ... failed (99:
# Address not available) -> 502; ver load-tests/README.md). keepalive_timeout queda por
# debajo del de Tomcat (20 s por defecto) para no reutilizar una conexion que ya cerro.
upstream ruta_backend {
    server backend:8080;
    keepalive 64;
    keepalive_timeout 15s;
}

include /etc/nginx/snippets/csp-map.conf;

server {
    listen 8080;
    server_name ${SERVER_NAME};
    location = /healthz { return 200 "ok"; add_header Content-Type text/plain; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 8443 ssl;
    server_name ${SERVER_NAME};

    include /etc/nginx/snippets/cloudflare-realip.conf;
    include /etc/nginx/snippets/tls.conf;

    # CSP por ruta (/api/ y Swagger), ver snippets/csp-map.conf
    add_header Content-Security-Policy $api_csp always;

    client_max_body_size 15M;

    location = /healthz {
        return 200 "ok";
        add_header Content-Type text/plain;
    }

    location /api/ {
        include /etc/nginx/snippets/proxy-headers.conf;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_pass http://ruta_backend/api/;
    }

    include /etc/nginx/snippets/api-docs.conf;

    # Abrir la URL de la API en el navegador lleva a Swagger (que pide su usuario/clave).
    # Redireccion absoluta y a proposito: con una ruta relativa nginx agregaria el puerto
    # interno (8443) al Location. 302 y no 301: el navegador no la cachea para siempre.
    location = / {
        return 302 https://$host/swagger-ui/index.html;
    }

    location / {
        return 404;
    }
}
