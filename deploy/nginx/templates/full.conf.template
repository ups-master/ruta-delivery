# Escenario B: backend y frontend en la misma VM, detras de este mismo nginx.
# /api -> backend; todo lo demas -> el frontend (que ya trae su propio nginx con el
# fallback de SPA y el proxy de /map-tiles, ver frontend/nginx.conf).

# nginx corre sin root (nginx-unprivileged): escucha en 8080/8443 dentro del contenedor;
# el compose los publica como 80/443 (HTTP_PORT/HTTPS_PORT).

# Conexiones persistentes hacia el backend. Sin esto nginx abre una conexion TCP nueva por
# peticion y, a ~300-400 req/s, agota los puertos efimeros (connect() ... failed (99:
# Address not available) -> 502; ver load-tests/README.md). keepalive_timeout queda por
# debajo del de Tomcat (20 s por defecto) para no reutilizar una conexion que ya cerro.
upstream ruta_backend {
    server backend:8080;
    keepalive 64;
    keepalive_timeout 15s;
}

include /etc/nginx/snippets/csp-map.conf;

server {
    listen 8080;
    server_name ${SERVER_NAME};
    location = /healthz { return 200 "ok"; add_header Content-Type text/plain; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 8443 ssl;
    server_name ${SERVER_NAME};

    include /etc/nginx/snippets/cloudflare-realip.conf;
    include /etc/nginx/snippets/tls.conf;

    # CSP por ruta (/api/ y Swagger), ver snippets/csp-map.conf
    add_header Content-Security-Policy $api_csp always;

    client_max_body_size 15M;

    location = /healthz {
        return 200 "ok";
        add_header Content-Type text/plain;
    }

    location /api/ {
        include /etc/nginx/snippets/proxy-headers.conf;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_pass http://ruta_backend/api/;
    }

    include /etc/nginx/snippets/api-docs.conf;

    location / {
        include /etc/nginx/snippets/proxy-headers.conf;
        proxy_pass http://frontend:8080;
    }
}
