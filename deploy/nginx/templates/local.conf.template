# Desarrollo local (ver deploy/env/local.env.example): mismo ruteo que full.conf.template
# (/api -> backend, / -> frontend) pero solo HTTP, sin TLS ni redirect -- evita depender
# de certificados y evita que un POST se rompa por un 301 -> https como el que si hace
# falta en produccion (escenario B). No incluye cloudflare-realip.conf: no hay Cloudflare
# delante en local, $remote_addr ya es la IP real (o la interna del propio Docker).

# nginx corre sin root (nginx-unprivileged): escucha en 8080 dentro del contenedor; el
# compose lo publica como HTTP_PORT.

# Conexiones persistentes hacia el backend (evita abrir una conexion TCP por peticion bajo
# carga). keepalive_timeout queda por debajo del de Tomcat (20 s por defecto) para no reutilizar
# una conexion que ya cerro.
upstream ruta_backend {
    server backend:8080;
    keepalive 64;
    keepalive_timeout 15s;
}

include /etc/nginx/snippets/csp-map.conf;

server {
    listen 8080;
    server_name ${SERVER_NAME};

    client_max_body_size 15M;
    # CSP por ruta (/api/ y Swagger), ver snippets/csp-map.conf
    add_header Content-Security-Policy $api_csp always;

    location = /healthz {
        return 200 "ok";
        add_header Content-Type text/plain;
    }

    location /api/ {
        include /etc/nginx/snippets/proxy-headers.conf;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_pass http://ruta_backend/api/;
    }

    include /etc/nginx/snippets/api-docs.conf;

    location / {
        include /etc/nginx/snippets/proxy-headers.conf;
        proxy_pass http://frontend:8080;
    }
}
